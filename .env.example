# OrchestrAI configuration. Copy to `.env` and fill in only what you need.
# `.env` is git-ignored. Credentials are read by the server only and are never sent to the browser.

# --- Server -----------------------------------------------------------------
# Bind address. Keep loopback: the API has no user accounts and anyone who can
# reach it can approve actions. Non-loopback hosts are refused unless
# ORCHESTRAI_ALLOW_REMOTE=true (put an authenticating reverse proxy in front first).
HOST=127.0.0.1
PORT=8787
ORCHESTRAI_ALLOW_REMOTE=false
# Extra Host header values to accept besides localhost/127.0.0.1/[::1] (comma-separated).
ALLOWED_HOSTS=

# SQLite database file (created automatically).
DATABASE_PATH=./data/orchestrai.db

# --- Background worker ------------------------------------------------------
# Set to false to run the API without the worker and start it with `npm run worker`.
WORKER_ENABLED=true
WORKER_INTERVAL_MS=1000
WORKER_CONCURRENCY=4

# --- Demo adapter (simulated, no external calls) -----------------------------
DEMO_DELAY_MS=1200

# --- OpenAI API (stateless model access; NOT ChatGPT Projects) ---------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=4000
# Used to estimate spend for budgets. Check current pricing for your model.
OPENAI_INPUT_CENTS_PER_MTOK=15
OPENAI_OUTPUT_CENTS_PER_MTOK=60

# --- Anthropic API (stateless model access; NOT Claude.ai Projects) ---------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_OUTPUT_TOKENS=4000
ANTHROPIC_INPUT_CENTS_PER_MTOK=300
ANTHROPIC_OUTPUT_CENTS_PER_MTOK=1500

# --- GitHub -----------------------------------------------------------------
# Fine-grained personal access token limited to the repositories you orchestrate.
# Permissions: Issues (read & write), Contents (read), Checks (read), Metadata (read).
GITHUB_TOKEN=
GITHUB_POLL_INTERVAL_MS=60000
