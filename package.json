{
  "name": "orchestrai",
  "version": "1.0.0",
  "description": "Local AI work orchestrator: keeps multiple AI-assisted projects moving toward verified outcomes.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/main.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/server/main.js",
    "worker": "tsx server/workerMain.ts",
    "demo:seed": "tsx server/demo/seedCli.ts",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/TheBurungo/orchestrai"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
